#!/bin/bash
# Select a screen region, OCR it, copy to clipboard, and speak with Piper.

VOICE_DIR="${SCREEN_SPEAK_VOICE_DIR:-$HOME/.local/share/piper}"
VOICE="${SCREEN_SPEAK_VOICE:-en_GB-northern_english_male-medium}"

if [[ $1 == --check ]]; then
  screen-speak-prep --check
  exit $?
fi

cleanup_freeze() {
  [[ -n $PID ]] && kill "$PID" 2>/dev/null
}
trap cleanup_freeze EXIT

# Keep hyprpicker alive until after grim (same as omarchy-capture-text).
hyprpicker -r -z >/dev/null 2>&1 &
PID=$!
sleep .1
SELECTION=$(slurp 2>/dev/null)

[[ -z $SELECTION ]] && exit 0

RAW=$(grim -g "$SELECTION" - | tesseract stdin stdout --oem 1 --psm 6 -l "${OMARCHY_OCR_LANGS:-eng}" --dpi 300 -c preserve_interword_spaces=1 2>/dev/null) || exit 1
[[ -z $RAW ]] && exit 1
printf '%s' "$RAW" | wl-copy

TEXT=$(printf '%s' "$RAW" | screen-speak-prep)
[[ -z $TEXT ]] && exit 1

screen-speak-stop

omarchy-notification-send -g 󰔊 "Speaking selection…"

# Prep emits newline-separated chunks (≤3 sentences); Piper reads each line.
(
  printf '%s\n' "$TEXT" | python3 -m piper \
    -m "$VOICE" \
    --data-dir "$VOICE_DIR" \
    --length-scale 0.75 \
    --noise-scale 0.75 \
    --noise-w-scale 1.0 \
    --sentence-silence 0.25
) &

exit 0
