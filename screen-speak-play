#!/usr/bin/env python3
"""Speak prep'd text with Piper.

Commas (and dashes, which prep maps to commas) → in-stream pause phonemes.
Paragraph breaks → real silence. Sentence endings → shorter silence.
"""

from __future__ import annotations

import os
import re
import sys
from pathlib import Path

from piper import PiperVoice, SynthesisConfig
from piper.audio_playback import AudioPlayer

VOICE_DIR = Path(os.environ.get("SCREEN_SPEAK_VOICE_DIR", Path.home() / ".local/share/piper"))
VOICE = os.environ.get("SCREEN_SPEAK_VOICE", "en_GB-northern_english_male-medium")
LENGTH = float(os.environ.get("SCREEN_SPEAK_LENGTH_SCALE", "0.75"))
COMMA_PAUSE = os.environ.get("SCREEN_SPEAK_COMMA_PAUSE", "[[ _ _ _ _ _ ]]")
SENTENCE_SILENCE = float(os.environ.get("SCREEN_SPEAK_SENTENCE_SILENCE", "0.22"))
PARA_SILENCE = float(os.environ.get("SCREEN_SPEAK_PARA_SILENCE", "0.55"))


def resolve_model() -> Path:
    direct = Path(VOICE)
    if direct.suffix == ".onnx" and direct.is_file():
        return direct
    candidate = VOICE_DIR / f"{VOICE}.onnx"
    if candidate.is_file():
        return candidate
    raise SystemExit(f"Voice not found: {candidate}")


def silence_bytes(sample_rate: int, seconds: float) -> bytes:
    n = int(sample_rate * seconds) * 2
    if n % 2:
        n += 1
    return bytes(n)


def protect_phoneme_blocks(text: str) -> tuple[str, list[str]]:
    blocks: list[str] = []

    def repl(m: re.Match[str]) -> str:
        blocks.append(m.group(0))
        return f"\x01{len(blocks) - 1}\x01"

    return re.sub(r"\[\[[^\]]*\]\]", repl, text), blocks


def restore_phoneme_blocks(text: str, blocks: list[str]) -> str:
    def repl(m: re.Match[str]) -> str:
        return blocks[int(m.group(1))]

    return re.sub(r"\x01(\d+)\x01", repl, text)


def inject_clause_pauses(text: str) -> str:
    """Commas/semicolons/dashes → same breath; keep one synthesize call."""
    text, blocks = protect_phoneme_blocks(text)
    text = re.sub(r"\s*[—–−‒]+\s*", ", ", text)
    text = re.sub(r"\s+-\s+", ", ", text)
    text = re.sub(r"\s*[,;]+\s*", f" {COMMA_PAUSE} ", text)
    text = restore_phoneme_blocks(text, blocks)
    return re.sub(r"\s+", " ", text).strip()


def split_sentences(text: str) -> list[str]:
    text, blocks = protect_phoneme_blocks(text)
    text = re.sub(r"\s+", " ", text.replace("\n", " ")).strip()
    if not text:
        return []
    parts = re.split(r"(?<=[.!?])\s+", text)
    out: list[str] = []
    for p in parts:
        p = restore_phoneme_blocks(p.strip(), blocks)
        if p and re.search(r"\w", p):
            out.append(p)
    return out


def play_paragraph(
    voice: PiperVoice,
    cfg: SynthesisConfig,
    player: AudioPlayer,
    text: str,
    sentence_pad: bytes,
) -> None:
    sentences = split_sentences(text)
    for i, sent in enumerate(sentences):
        spoken = inject_clause_pauses(sent)
        if not spoken:
            continue
        for chunk in voice.synthesize(spoken, cfg):
            player.play(chunk.audio_int16_bytes)
        if i < len(sentences) - 1:
            player.play(sentence_pad)


def play_text(text: str) -> None:
    model = resolve_model()
    voice = PiperVoice.load(model)
    cfg = SynthesisConfig(
        length_scale=LENGTH,
        noise_scale=0.75,
        noise_w_scale=1.0,
    )
    rate = voice.config.sample_rate
    sentence_pad = silence_bytes(rate, SENTENCE_SILENCE)
    para_pad = silence_bytes(rate, PARA_SILENCE)

    paragraphs = [p.strip() for p in re.split(r"\n\s*\n", text) if p.strip()]
    if not paragraphs:
        return

    with AudioPlayer(rate) as player:
        for i, para in enumerate(paragraphs):
            para_flat = " ".join(line.strip() for line in para.splitlines() if line.strip())
            play_paragraph(voice, cfg, player, para_flat, sentence_pad)
            if i < len(paragraphs) - 1:
                player.play(para_pad)


def main() -> int:
    if "--check" in sys.argv:
        s = inject_clause_pauses("Soldiers, when draining, stop.")
        assert "_ _" in s, s
        assert "," not in re.sub(r"\[\[[^\]]*\]\]", "", s), s
        d = inject_clause_pauses("awaits — else trouble.")
        # Dash uses the same pause marker as commas
        assert COMMA_PAUSE in d or "_ _" in d, d
        assert "—" not in d, d
        sents = split_sentences("One. Two! Three?")
        assert len(sents) == 3, sents
        s2 = inject_clause_pauses("[[ aɪ ]] went, then [[ aɪ ]] left.")
        assert s2.count("[[ aɪ ]]") == 2, s2
        print("ok")
        return 0

    text = sys.stdin.read().strip()
    if not text:
        return 1
    play_text(text)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
