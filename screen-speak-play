#!/usr/bin/env python3
"""Speak prep'd text with Piper, inserting real silence after commas and sentences.

Piper's --sentence-silence only applies between .!? sentences — commas are otherwise
nearly inaudible at faster length-scales. This player splits on clause punctuation
and plays short breaths after commas/semicolons.
"""

from __future__ import annotations

import os
import re
import sys
import wave
from pathlib import Path

from piper import PiperVoice, SynthesisConfig
from piper.audio_playback import AudioPlayer

VOICE_DIR = Path(os.environ.get("SCREEN_SPEAK_VOICE_DIR", Path.home() / ".local/share/piper"))
VOICE = os.environ.get("SCREEN_SPEAK_VOICE", "en_GB-northern_english_male-medium")
LENGTH = float(os.environ.get("SCREEN_SPEAK_LENGTH_SCALE", "0.75"))
COMMA_SILENCE = float(os.environ.get("SCREEN_SPEAK_COMMA_SILENCE", "0.18"))
SENTENCE_SILENCE = float(os.environ.get("SCREEN_SPEAK_SENTENCE_SILENCE", "0.28"))


def resolve_model() -> Path:
    direct = Path(VOICE)
    if direct.suffix == ".onnx" and direct.is_file():
        return direct
    candidate = VOICE_DIR / f"{VOICE}.onnx"
    if candidate.is_file():
        return candidate
    raise SystemExit(f"Voice not found: {candidate}")


def segments(text: str) -> list[tuple[str, str]]:
    """Split into (spoken_text, pause_kind) where pause_kind is comma|sentence|none."""
    text = re.sub(r"\s+", " ", text.replace("\n", " ")).strip()
    if not text:
        return []
    out: list[tuple[str, str]] = []
    # Keep trailing punctuation with each clause
    parts = re.findall(r"[^.!,?;]+(?:[.!,?;]+)?", text)
    for part in parts:
        part = part.strip()
        if not part:
            continue
        if re.search(r"[.!?]+$", part):
            kind = "sentence"
        elif re.search(r"[,;]+$", part):
            kind = "comma"
        else:
            kind = "none"
        # Don't speak bare punctuation
        spoken = part.strip()
        if not re.search(r"\w", spoken):
            continue
        out.append((spoken, kind))
    return out


def silence_bytes(sample_rate: int, seconds: float) -> bytes:
    n = int(sample_rate * seconds) * 2  # 16-bit mono
    # even byte count
    if n % 2:
        n += 1
    return bytes(n)


def play_text(text: str) -> None:
    model = resolve_model()
    voice = PiperVoice.load(model)
    cfg = SynthesisConfig(
        length_scale=LENGTH,
        noise_scale=0.75,
        noise_w_scale=1.0,
    )
    rate = voice.config.sample_rate
    comma_pad = silence_bytes(rate, COMMA_SILENCE)
    sentence_pad = silence_bytes(rate, SENTENCE_SILENCE)

    segs = segments(text)
    if not segs:
        return

    with AudioPlayer(rate) as player:
        for spoken, kind in segs:
            for chunk in voice.synthesize(spoken, cfg):
                player.play(chunk.audio_int16_bytes)
            if kind == "comma":
                player.play(comma_pad)
            elif kind == "sentence":
                player.play(sentence_pad)


def main() -> int:
    if "--check" in sys.argv:
        s = segments("Soldiers, when draining, stop. Go.")
        assert [t for t, _ in s][0].startswith("Soldiers"), s
        assert any(k == "comma" for _, k in s), s
        assert any(k == "sentence" for _, k in s), s
        print("ok")
        return 0

    text = sys.stdin.read().strip()
    if not text:
        return 1
    # Multiple prep chunks (newlines) — speak sequentially with sentence pad between
    chunks = [c.strip() for c in text.splitlines() if c.strip()]
    if not chunks:
        return 1
    combined = " ".join(chunks)
    play_text(combined)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
