#!/usr/bin/env python3
"""Kokoro TTS for screen-speak (stdin → wav → play). On-demand; exits when done."""

from __future__ import annotations

import os
import subprocess
import sys
import tempfile
from pathlib import Path

import numpy as np


MODEL_DIR = Path(
    os.environ.get("SCREEN_SPEAK_KOKORO_DIR", Path.home() / ".local/share/kokoro")
)
MODEL = Path(os.environ.get("SCREEN_SPEAK_KOKORO_MODEL", MODEL_DIR / "kokoro-v1.0.onnx"))
VOICES = Path(os.environ.get("SCREEN_SPEAK_KOKORO_VOICES", MODEL_DIR / "voices-v1.0.bin"))
VOICE = os.environ.get("SCREEN_SPEAK_KOKORO_VOICE", "bm_george")
# >1.0 = faster. 1.2 ≈ fairly fast while still natural.
SPEED = float(os.environ.get("SCREEN_SPEAK_KOKORO_SPEED", "1.2"))
LANG = os.environ.get("SCREEN_SPEAK_KOKORO_LANG", "en-gb")


def _patch_speed_dtype() -> None:
    """PyPI kokoro-onnx 0.4.7 passes speed as int32; v1.0 models need float32."""
    import time

    from kokoro_onnx import MAX_PHONEME_LENGTH, SAMPLE_RATE, Kokoro, log

    if getattr(Kokoro, "_screen_speak_speed_patched", False):
        return

    def fixed_create_audio(self, phonemes, voice, speed):  # type: ignore[no-untyped-def]
        log.debug(f"Phonemes: {phonemes}")
        if len(phonemes) > MAX_PHONEME_LENGTH:
            log.warning(
                f"Phonemes are too long, truncating to {MAX_PHONEME_LENGTH} phonemes"
            )
        phonemes = phonemes[:MAX_PHONEME_LENGTH]
        start_t = time.time()
        tokens = np.array(self.tokenizer.tokenize(phonemes), dtype=np.int64)
        assert len(tokens) <= MAX_PHONEME_LENGTH
        voice = voice[len(tokens)]
        tokens = [[0, *tokens, 0]]
        input_names = [i.name for i in self.sess.get_inputs()]
        if "input_ids" in input_names:
            inputs = {
                "input_ids": tokens,
                "style": np.array(voice, dtype=np.float32),
                "speed": np.array([speed], dtype=np.float32),
            }
        else:
            inputs = {
                "tokens": tokens,
                "style": voice,
                "speed": np.ones(1, dtype=np.float32) * speed,
            }
        audio = self.sess.run(None, inputs)[0]
        audio_duration = len(audio) / SAMPLE_RATE
        create_duration = time.time() - start_t
        rtf = create_duration / audio_duration if audio_duration else 0
        log.debug(
            f"Created audio in length of {audio_duration:.2f}s for {len(phonemes)} "
            f"phonemes in {create_duration:.2f}s (RTF: {rtf:.2f})"
        )
        return audio, SAMPLE_RATE

    Kokoro._create_audio = fixed_create_audio  # type: ignore[method-assign]
    Kokoro._screen_speak_speed_patched = True  # type: ignore[attr-defined]


def synthesize(text: str) -> tuple[np.ndarray, int]:
    from kokoro_onnx import Kokoro

    _patch_speed_dtype()
    if not MODEL.is_file() or not VOICES.is_file():
        raise SystemExit(
            f"Kokoro model missing. Expected:\n  {MODEL}\n  {VOICES}\n"
            "Download from https://github.com/thewh1teagle/kokoro-onnx/releases"
        )
    kokoro = Kokoro(str(MODEL), str(VOICES))
    samples, sr = kokoro.create(text, voice=VOICE, speed=SPEED, lang=LANG)
    return np.asarray(samples, dtype=np.float32), int(sr)


def play(samples: np.ndarray, sr: int) -> None:
    import soundfile as sf

    with tempfile.NamedTemporaryFile(suffix=".wav", delete=False) as tmp:
        path = tmp.name
    try:
        sf.write(path, samples, sr)
        # ffplay is already required by Piper path
        subprocess.run(
            ["ffplay", "-nodisp", "-autoexit", "-loglevel", "quiet", path],
            check=False,
        )
    finally:
        try:
            os.unlink(path)
        except OSError:
            pass


def main() -> int:
    if "--check" in sys.argv:
        _patch_speed_dtype()
        from kokoro_onnx import Kokoro

        assert MODEL.is_file(), MODEL
        assert VOICES.is_file(), VOICES
        Kokoro(str(MODEL), str(VOICES))
        # Smoke-synth a short phrase (proves float speed patch works)
        samples, sr = synthesize("Hello.")
        assert len(samples) > 0 and sr > 0
        print("ok")
        return 0

    text = sys.stdin.read().strip()
    if not text:
        return 1
    samples, sr = synthesize(text)
    play(samples, sr)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
